PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resqtrack

JWT_SECRET=resqtrack_jwt_secret_dev_2024
JWT_REFRESH_SECRET=resqtrack_refresh_secret_dev_2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3y

UPLOAD_DIR=./server/uploads

# ── Email Configuration (Brevo) ──────────────────────────────
# Sender details (must match your verified sender in Brevo):
MAIL_FROM=system@resqtrack.online
MAIL_FROM_NAME=ResQTrack

# OPTION 1: Brevo HTTPS REST API (Recommended — port 443, never blocked):
# Generate under Brevo Dashboard -> SMTP & API -> API Keys (starts with xkeysib-...)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# OPTION 2: Brevo SMTP Relay:
# Generate under Brevo Dashboard -> SMTP & API -> SMTP Key (starts with xsmtpsib-...)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_brevo_login_email@example.com
MAIL_PASS=your_brevo_smtp_key

# Optional — SMS notifications no-op safely if left unset (see server/utils/sms.js)
# PhilSMS: https://app.philsms.com/developers/documentation
PHILSMS_BASE_URL=https://app.philsms.com/api/v3
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=PhilSMS
# Optional — shared secret for the inbound "report by SMS" webhook (server/controllers/sms.controller.js)
SMS_WEBHOOK_SECRET=

# Optional — address matching at registration no-ops safely if left unset (see server/utils/geocode.js)
# Google Geocoding API key: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAP_API=
